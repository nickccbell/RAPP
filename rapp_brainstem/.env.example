# GitHub token — get yours from: gh auth token
# Or run `gh auth login` first and leave this blank (auto-detected)
GITHUB_TOKEN=

# Model to use (Copilot supports: gpt-4o, gpt-4o-mini, gpt-4.1, o3-mini, claude-3.5-sonnet)
GITHUB_MODEL=gpt-4o

# Point to your private soul and agents (optional — defaults to ./soul.md and ./agents/)
SOUL_PATH=./soul.md
AGENTS_PATH=./agents

# Port (default: 7071)
PORT=7071

# Password for voice.zip (ElevenLabs API key config)
VOICE_ZIP_PASSWORD=

# Extra CORS origins (comma-separated) for browser clients outside the defaults
# (localhost, 127.0.0.1 on any port, https://kody-w.github.io).
# Example: RAPP_CORS_ORIGINS=https://my-ui.example.com,https://other.example.com
RAPP_CORS_ORIGINS=

# ── Multi-backend LLM config ─────────────────────────────────────────────────
# Which backend to use by default (github_copilot | openai | anthropic | ollama)
# Can also be changed at runtime via PATCH /api/settings
LLM_BACKEND=github_copilot

# OpenAI — set OPENAI_API_KEY to enable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — set ANTHROPIC_API_KEY to enable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (local inference) — install from https://ollama.com then run: ollama serve
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
